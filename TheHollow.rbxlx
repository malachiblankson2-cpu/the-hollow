local function shopButton(text, color, order, onClick)
	local b = make("TextButton", {
		Size = UDim2.fromOffset(180, 38),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.15,
		Font = Enum.Font.GothamBold,
