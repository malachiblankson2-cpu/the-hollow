<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="ReplicatedStorage" referent="RBX00000002"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- Config (ModuleScript in ReplicatedStorage)
-- Every number you'd want to tweak lives here. Shared by server and client.

local Config = {}

Config.GAME_NAME = "THE HOLLOW"

-- Rounds
Config.MIN_PLAYERS = 1          -- set to 2+ once you have real traffic
Config.INTERMISSION = 15        -- seconds in the lobby between rounds
Config.ROUND_TIME = 240         -- seconds per round
Config.KEYS_TO_ESCAPE = 5

-- Maze (regenerated every round)
Config.MAZE_WIDTH = 10          -- cells
Config.MAZE_HEIGHT = 10
Config.CELL_SIZE = 16           -- studs
Config.WALL_HEIGHT = 14
Config.EXTRA_OPENINGS = 0.12    -- chance to knock out extra walls so there are escape loops
Config.FLICKER_LAMPS = 10

-- Atmosphere
Config.FOG_DISTANCE = 70

-- Player movement
Config.WALK_SPEED = 14
Config.SPRINT_SPEED = 22
Config.STAMINA_SECONDS = 4      -- free players can sprint this long before resting
Config.STAMINA_REGEN = 0.5      -- stamina regained per second (fraction of full bar)

-- Monster
Config.MONSTER_WAKE_DELAY = 10  -- seconds of head start at the start of a round
Config.MONSTER_HUNT_SPEED = 9   -- when it can't see you (it always knows roughly where you are)
Config.MONSTER_CHASE_SPEED = 17 -- when it has line of sight
Config.MONSTER_SIGHT = 60
Config.MONSTER_KILL_RANGE = 4.5

-- Sounds: each slot lists IDs to try in order. The first one that loads gets used,
-- so if Roblox removes one the game falls back to the next. If a slot stays silent,
-- the Output window says which one: put a working ID from the Creator Store at the front.
Config.Sounds = {
	Jumpscare = { "rbxassetid://6754147732", "rbxassetid://6349647514", "rbxassetid://194068083" },
	Ambient = { "rbxassetid://140704980462451", "rbxassetid://139765110669684", "rbxassetid://139743346356072" },
	Heartbeat = { "rbxassetid://9082241193", "rbxassetid://9204476603" },
	Growl = { "rbxassetid://276691872" },
	Whisper = { "rbxassetid://9001132274", "rbxassetid://8873346609" },
	Stinger = { "rbxassetid://160442088", "rbxassetid://150829983", "rbxassetid://6899144196" },
	Key = { "rbxasset://sounds/electronicpingshort.wav" },
}

-- MONETIZATION -------------------------------------------------------------
-- Create these on create.roblox.com (see README), then paste the numeric IDs.
-- Anything left at 0 is hidden from the shop, so the game works before you set them up.

Config.GamePasses = {
	SuperFlashlight = 0, -- one-time purchase: brighter, wider, longer flashlight
	InfiniteStamina = 0, -- one-time purchase: sprint forever
}

Config.Products = {
	Revive = 0,      -- repeatable: come back to life mid-round
	StunMonster = 0, -- repeatable: freeze the monster for everyone
}

Config.STUN_DURATION = 10

-- Shop labels (prices are set on the Roblox website, these are just display text)
Config.ShopText = {
	SuperFlashlight = "Super Flashlight",
	InfiniteStamina = "Infinite Stamina",
	Revive = "Revive",
	StunMonster = "Freeze Monster",
}

return Config
]]></ProtectedString></Properties></Item></Item><Item class="ServerScriptService" referent="RBX00000004"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000003"><Properties><string name="Name">GameServer</string><ProtectedString name="Source"><![CDATA[-- GameServer (Script in ServerScriptService)
-- Builds the world, runs rounds, drives the monster, saves stats and handles purchases.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")
local MarketplaceService = game:GetService("MarketplaceService")
local DataStoreService = game:GetService("DataStoreService")

local Config = require(ReplicatedStorage:WaitForChild("Config"))

-- We spawn characters ourselves so nobody loads in before the map exists.
Players.CharacterAutoLoads = false

---------------------------------------------------------------------------
-- Remotes and shared state
---------------------------------------------------------------------------

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = ReplicatedStorage

local jumpscareEvent = Instance.new("RemoteEvent")
jumpscareEvent.Name = "Jumpscare"
jumpscareEvent.Parent = remotes

local notifyEvent = Instance.new("RemoteEvent")
notifyEvent.Name = "Notify"
notifyEvent.Parent = remotes

local function setShared(name, value)
	ReplicatedStorage:SetAttribute(name, value)
end

local function notifyAll(text, color)
	notifyEvent:FireAllClients(text, color)
end

local function notify(player, text, color)
	notifyEvent:FireClient(player, text, color)
end

setShared("State", "Waiting")
setShared("TimeLeft", 0)
setShared("KeysFound", 0)
setShared("KeysNeeded", Config.KEYS_TO_ESCAPE)

---------------------------------------------------------------------------
-- Lighting: pitch dark, heavy fog
---------------------------------------------------------------------------

for _, child in ipairs(Lighting:GetChildren()) do
	if child:IsA("Atmosphere") or child:IsA("Sky") or child:IsA("PostEffect") then
		child:Destroy()
	end
end

Lighting.ClockTime = 0
Lighting.Brightness = 0
Lighting.Ambient = Color3.fromRGB(8, 8, 12)
Lighting.OutdoorAmbient = Color3.fromRGB(8, 8, 12)
Lighting.EnvironmentDiffuseScale = 0
Lighting.EnvironmentSpecularScale = 0
Lighting.GlobalShadows = true
Lighting.FogColor = Color3.new(0, 0, 0)
Lighting.FogStart = 0
Lighting.FogEnd = Config.FOG_DISTANCE

local grade = Instance.new("ColorCorrectionEffect")
grade.Saturation = -0.45
grade.Contrast = 0.15
grade.TintColor = Color3.fromRGB(215, 225, 255)
grade.Parent = Lighting

---------------------------------------------------------------------------
-- Building helpers
---------------------------------------------------------------------------

local function makePart(props, parent)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = parent
	return p
end

---------------------------------------------------------------------------
-- Lobby (safe, lit room players wait in)
---------------------------------------------------------------------------

local LOBBY_CENTER = Vector3.new(Config.MAZE_WIDTH * Config.CELL_SIZE / 2, 0, -90)

local function buildLobby()
	local lobby = Instance.new("Folder")
	lobby.Name = "Lobby"
	lobby.Parent = workspace

	local size, h = 50, 16
	makePart({
		Name = "Floor",
		Size = Vector3.new(size, 1, size),
		Position = LOBBY_CENTER - Vector3.new(0, 0.5, 0),
		Material = Enum.Material.WoodPlanks,
		Color = Color3.fromRGB(70, 50, 40),
	}, lobby)
	makePart({
		Name = "Roof",
		Size = Vector3.new(size, 1, size),
		Position = LOBBY_CENTER + Vector3.new(0, h + 0.5, 0),
		Color = Color3.fromRGB(30, 25, 25),
	}, lobby)
	local walls = {
		{ Vector3.new(0, h / 2, size / 2), Vector3.new(size, h, 1) },
		{ Vector3.new(0, h / 2, -size / 2), Vector3.new(size, h, 1) },
		{ Vector3.new(size / 2, h / 2, 0), Vector3.new(1, h, size) },
		{ Vector3.new(-size / 2, h / 2, 0), Vector3.new(1, h, size) },
	}
	for i, w in ipairs(walls) do
		makePart({
			Name = "Wall" .. i,
			Size = w[2],
			Position = LOBBY_CENTER + w[1],
			Material = Enum.Material.Brick,
			Color = Color3.fromRGB(60, 40, 38),
		}, lobby)
	end

	local lamp = makePart({
		Name = "Lamp",
		Size = Vector3.new(2, 1, 2),
		Position = LOBBY_CENTER + Vector3.new(0, h - 0.5, 0),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 190, 120),
		CanCollide = false,
	}, lobby)
	local light = Instance.new("PointLight")
	light.Range = 40
	light.Brightness = 1.5
	light.Color = Color3.fromRGB(255, 190, 120)
	light.Parent = lamp

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(8, 1, 8)
	spawn.Position = LOBBY_CENTER + Vector3.new(0, 0.1, 0)
	spawn.Color = Color3.fromRGB(40, 30, 30)
	spawn.Material = Enum.Material.Slate
	spawn.Parent = lobby

	-- Sign on the wall explaining the game
	local sign = makePart({
		Name = "Sign",
		Size = Vector3.new(24, 9, 0.5),
		Position = LOBBY_CENTER + Vector3.new(0, 8, size / 2 - 1),
		Color = Color3.fromRGB(15, 10, 10),
	}, lobby)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.Parent = sign
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.Creepster
	label.TextColor3 = Color3.fromRGB(200, 30, 30)
	label.Text = Config.GAME_NAME
		.. "\nFind "
		.. Config.KEYS_TO_ESCAPE
		.. " keys. Reach the gate.\nDon't let it see you."
	label.Parent = gui
	-- The sign faces into the room
	sign.CFrame = CFrame.lookAt(sign.Position, LOBBY_CENTER + Vector3.new(0, 8, 0))
end

buildLobby()

---------------------------------------------------------------------------
-- Maze generation (new layout every round)
---------------------------------------------------------------------------

local CELL = Config.CELL_SIZE
local W, H = Config.MAZE_WIDTH, Config.MAZE_HEIGHT
local WALL_T = 2

local mazeFolder: Folder? = nil
local exitDoor: BasePart? = nil
local exitOpen = false
local keysFound = 0

local function cellCenter(x, y)
	return Vector3.new((x - 0.5) * CELL, 0, (y - 0.5) * CELL)
end

local function generateCells(rng)
	local cells = {}
	for x = 1, W do
		cells[x] = {}
		for y = 1, H do
			cells[x][y] = { n = true, s = true, e = true, w = true, visited = false }
		end
	end

	-- Recursive backtracker
	local stack = { { 1, 1 } }
	cells[1][1].visited = true
	while #stack > 0 do
		local cur = stack[#stack]
		local x, y = cur[1], cur[2]
		local options = {}
		if y > 1 and not cells[x][y - 1].visited then
			table.insert(options, { x, y - 1, "n", "s" })
		end
		if y < H and not cells[x][y + 1].visited then
			table.insert(options, { x, y + 1, "s", "n" })
		end
		if x < W and not cells[x + 1][y].visited then
			table.insert(options, { x + 1, y, "e", "w" })
		end
		if x > 1 and not cells[x - 1][y].visited then
			table.insert(options, { x - 1, y, "w", "e" })
		end
		if #options == 0 then
			table.remove(stack)
		else
			local o = options[rng:NextInteger(1, #options)]
			cells[x][y][o[3]] = false
			cells[o[1]][o[2]][o[4]] = false
			cells[o[1]][o[2]].visited = true
			table.insert(stack, { o[1], o[2] })
		end
	end

	-- Knock out a few extra walls so there are loops to escape through
	for x = 1, W do
		for y = 1, H do
			if x < W and rng:NextNumber() < Config.EXTRA_OPENINGS then
				cells[x][y].e = false
				cells[x + 1][y].w = false
			end
			if y < H and rng:NextNumber() < Config.EXTRA_OPENINGS then
				cells[x][y].s = false
				cells[x][y + 1].n = false
			end
		end
	end
	return cells
end

local function wallPart(parent, position, size)
	return makePart({
		Name = "Wall",
		Size = size,
		Position = position,
		Material = Enum.Material.Concrete,
		Color = Color3.fromRGB(55, 55, 60),
	}, parent)
end

local function startFlicker(lampPart, light, rng)
	task.spawn(function()
		while lampPart.Parent do
			light.Enabled = rng:NextNumber() > 0.3
			lampPart.Transparency = light.Enabled and 0 or 0.8
			task.wait(rng:NextNumber(0.05, 0.6))
		end
	end)
end

local onKeyTouched -- defined below, needs round state
local onExitTouched

local function buildMaze()
	if mazeFolder then
		mazeFolder:Destroy()
	end
	local rng = Random.new()
	local cells = generateCells(rng)

	mazeFolder = Instance.new("Folder")
	mazeFolder.Name = "Maze"
	mazeFolder.Parent = workspace
	local wallsFolder = Instance.new("Folder")
	wallsFolder.Name = "Walls"
	wallsFolder.Parent = mazeFolder

	makePart({
		Name = "Floor",
		Size = Vector3.new(W * CELL + WALL_T, 1, H * CELL + WALL_T),
		Position = Vector3.new(W * CELL / 2, -0.5, H * CELL / 2),
		Material = Enum.Material.Slate,
		Color = Color3.fromRGB(35, 33, 33),
	}, mazeFolder)

	local yMid = Config.WALL_HEIGHT / 2
	for x = 1, W do
		for y = 1, H do
			local c = cells[x][y]
			local center = cellCenter(x, y)
			if c.n then
				wallPart(
					wallsFolder,
					Vector3.new(center.X, yMid, (y - 1) * CELL),
					Vector3.new(CELL + WALL_T, Config.WALL_HEIGHT, WALL_T)
				)
			end
			if c.w then
				wallPart(
					wallsFolder,
					Vector3.new((x - 1) * CELL, yMid, center.Z),
					Vector3.new(WALL_T, Config.WALL_HEIGHT, CELL + WALL_T)
				)
			end
			if y == H then
				wallPart(
					wallsFolder,
					Vector3.new(center.X, yMid, y * CELL),
					Vector3.new(CELL + WALL_T, Config.WALL_HEIGHT, WALL_T)
				)
			end
			-- East border, except the exit gate in the far corner
			if x == W and y ~= H then
				wallPart(
					wallsFolder,
					Vector3.new(x * CELL, yMid, center.Z),
					Vector3.new(WALL_T, Config.WALL_HEIGHT, CELL + WALL_T)
				)
			end
		end
	end

	-- Exit gate
	local exitCenter = cellCenter(W, H)
	exitOpen = false
	exitDoor = makePart({
		Name = "ExitGate",
		Size = Vector3.new(WALL_T, Config.WALL_HEIGHT, CELL + WALL_T),
		Position = Vector3.new(W * CELL, yMid, exitCenter.Z),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(140, 0, 0),
	}, mazeFolder)
	local gateLight = Instance.new("PointLight")
	gateLight.Name = "GateLight"
	gateLight.Range = 18
	gateLight.Color = Color3.fromRGB(255, 0, 0)
	gateLight.Parent = exitDoor
	exitDoor.Touched:Connect(onExitTouched)

	-- Keys in random cells away from the start
	keysFound = 0
	setShared("KeysFound", 0)
	local used = { ["1,1"] = true, [W .. "," .. H] = true }
	local placed = 0
	while placed < Config.KEYS_TO_ESCAPE do
		local x, y = rng:NextInteger(1, W), rng:NextInteger(1, H)
		local id = x .. "," .. y
		if not used[id] and (x + y) > 4 then
			used[id] = true
			placed += 1
			local key = makePart({
				Name = "Key",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(1.5, 1.5, 1.5),
				Position = cellCenter(x, y) + Vector3.new(0, 2.5, 0),
				Material = Enum.Material.Neon,
				Color = Color3.fromRGB(255, 200, 40),
				CanCollide = false,
			}, mazeFolder)
			local glow = Instance.new("PointLight")
			glow.Range = 10
			glow.Brightness = 2
			glow.Color = Color3.fromRGB(255, 200, 40)
			glow.Parent = key
			key.Touched:Connect(function(hit)
				onKeyTouched(key, hit)
			end)
		end
	end

	-- Flickering lamps for atmosphere
	for _ = 1, Config.FLICKER_LAMPS do
		local pos = cellCenter(rng:NextInteger(1, W), rng:NextInteger(1, H))
		local lamp = makePart({
			Name = "Lamp",
			Size = Vector3.new(1, 0.4, 1),
			Position = pos + Vector3.new(0, Config.WALL_HEIGHT - 1, 0),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 140, 80),
			CanCollide = false,
		}, mazeFolder)
		local light = Instance.new("PointLight")
		light.Range = 16
		light.Brightness = 0.8
		light.Color = Color3.fromRGB(255, 140, 80)
		light.Parent = lamp
		startFlicker(lamp, light, rng)
	end

	return wallsFolder
end

---------------------------------------------------------------------------
-- Player state, stats, saving
---------------------------------------------------------------------------

local roundActive = false
local status: { [Player]: string } = {} -- "Lobby" | "Alive" | "Dead" | "Escaped"
local reviveTokens: { [Player]: number } = {}
local pendingStuns = 0

local function setStatus(player, s)
	status[player] = s
	player:SetAttribute("Status", s)
end

local store
pcall(function()
	store = DataStoreService:GetDataStore("HollowStats_v1")
end)

local function loadStats(player, escapes)
	if not store then
		return
	end
	local ok, value = pcall(function()
		return store:GetAsync("escapes_" .. player.UserId)
	end)
	if ok and typeof(value) == "number" then
		escapes.Value = value
	end
end

local function saveStats(player)
	local stats = player:FindFirstChild("leaderstats")
	if not store or not stats then
		return
	end
	local escapes = stats:FindFirstChild("Escapes")
	pcall(function()
		store:SetAsync("escapes_" .. player.UserId, escapes.Value)
	end)
end

local function addEscape(player)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Escapes.Value += 1
	end
end

local function getAliveParts(player)
	local char = player.Character
	if not char then
		return nil
	end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hrp and hum and hum.Health > 0 then
		return hrp, hum
	end
	return nil
end

local function aliveCount()
	local n = 0
	for _, s in pairs(status) do
		if s == "Alive" then
			n += 1
		end
	end
	return n
end

---------------------------------------------------------------------------
-- Game passes
---------------------------------------------------------------------------

local function checkPasses(player)
	for name, id in pairs(Config.GamePasses) do
		if id > 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
			end)
			if ok and owns then
				player:SetAttribute(name, true)
			end
		end
	end
end

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	if not purchased then
		return
	end
	for name, id in pairs(Config.GamePasses) do
		if id == passId then
			player:SetAttribute(name, true)
			notify(player, "Unlocked: " .. (Config.ShopText[name] or name), Color3.fromRGB(120, 255, 120))
		end
	end
end)

---------------------------------------------------------------------------
-- Characters
---------------------------------------------------------------------------

local function onCharacterAdded(player, char)
	local hum = char:WaitForChild("Humanoid")
	char:WaitForChild("HumanoidRootPart")
	hum.WalkSpeed = Config.WALK_SPEED

	if roundActive and status[player] == "Alive" then
		task.wait()
		char:PivotTo(CFrame.new(cellCenter(1, 1) + Vector3.new(0, 3, 0)))
	end

	hum.Died:Connect(function()
		if player.Character ~= char then
			return
		end
		if roundActive and status[player] == "Alive" then
			if (reviveTokens[player] or 0) > 0 then
				-- Pre-bought revive: status stays Alive, they respawn back in the maze
				reviveTokens[player] -= 1
				notifyAll(player.DisplayName .. " used a revive!", Color3.fromRGB(120, 255, 120))
			else
				setStatus(player, "Dead")
				notifyAll(player.DisplayName .. " was taken...", Color3.fromRGB(255, 60, 60))
			end
		end
		task.wait(3)
		if player.Parent and player.Character == char then
			player:LoadCharacter()
		end
	end)
end

local function onPlayerAdded(player)
	setStatus(player, "Lobby")
	reviveTokens[player] = 0
	player.CameraMode = Enum.CameraMode.LockFirstPerson

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	stats.Parent = player
	local escapes = Instance.new("IntValue")
	escapes.Name = "Escapes"
	escapes.Parent = stats

	player.CharacterAdded:Connect(function(char)
		onCharacterAdded(player, char)
	end)

	task.spawn(loadStats, player, escapes)
	task.spawn(checkPasses, player)
	player:LoadCharacter()
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	saveStats(player)
	status[player] = nil
	reviveTokens[player] = nil
end)

game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		saveStats(player)
	end
end)

---------------------------------------------------------------------------
-- Monster
---------------------------------------------------------------------------

type Monster = {
	model: Model,
	root: BasePart,
	waypoints: { Vector3 },
	index: number,
	speed: number,
	wakeAt: number,
	stunnedUntil: number,
	catching: { [Player]: boolean },
}

local monster: Monster? = nil
local wallsFolder: Folder? = nil
local MONSTER_ROOT_Y = 5.5

local function buildMonster(position: Vector3): Monster
	local model = Instance.new("Model")
	model.Name = "Monster"

	local rootCF = CFrame.new(position.X, MONSTER_ROOT_Y, position.Z)
	local function bodyPart(name, size, offset, color, material)
		return makePart({
			Name = name,
			Size = size,
			CFrame = rootCF * offset,
			Color = color or Color3.fromRGB(10, 10, 10),
			Material = material or Enum.Material.SmoothPlastic,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = true,
		}, model)
	end

	local root = bodyPart("Root", Vector3.new(2, 2, 2), CFrame.new(), nil, nil)
	root.Transparency = 1
	model.PrimaryPart = root

	local black = Color3.fromRGB(8, 8, 8)
	bodyPart("Torso", Vector3.new(3, 5, 1.4), CFrame.new(0, 1.5, 0), black)
	bodyPart("LeftLeg", Vector3.new(0.9, 5, 0.9), CFrame.new(-0.8, -3, 0), black)
	bodyPart("RightLeg", Vector3.new(0.9, 5, 0.9), CFrame.new(0.8, -3, 0), black)
	bodyPart("LeftArm", Vector3.new(0.7, 7, 0.7), CFrame.new(-2, 0.5, -0.6) * CFrame.Angles(math.rad(25), 0, math.rad(-8)), black)
	bodyPart("RightArm", Vector3.new(0.7, 7, 0.7), CFrame.new(2, 0.5, -0.6) * CFrame.Angles(math.rad(25), 0, math.rad(8)), black)
	local head = bodyPart("Head", Vector3.new(2, 2.6, 2), CFrame.new(0, 5.4, 0) * CFrame.Angles(0, 0, math.rad(12)), black)
	local red = Color3.fromRGB(255, 0, 0)
	bodyPart("LeftEye", Vector3.new(0.35, 0.25, 0.1), CFrame.new(-0.5, 5.6, -1.02), red, Enum.Material.Neon)
	bodyPart("RightEye", Vector3.new(0.35, 0.25, 0.1), CFrame.new(0.5, 5.4, -1.02), red, Enum.Material.Neon)
	bodyPart("Mouth", Vector3.new(1.1, 0.15, 0.1), CFrame.new(0, 4.7, -1.02), Color3.fromRGB(90, 0, 0), Enum.Material.Neon)

	local eyeGlow = Instance.new("PointLight")
	eyeGlow.Color = red
	eyeGlow.Range = 12
	eyeGlow.Brightness = 2
	eyeGlow.Parent = head

	model.Parent = workspace
	return {
		model = model,
		root = root,
		waypoints = {},
		index = 1,
		speed = Config.MONSTER_HUNT_SPEED,
		wakeAt = os.clock() + Config.MONSTER_WAKE_DELAY,
		stunnedUntil = 0,
		catching = {},
	}
end

local function nearestTarget(from: Vector3)
	local best, bestDist, bestPos = nil, math.huge, nil
	for player, s in pairs(status) do
		if s == "Alive" then
			local hrp = getAliveParts(player)
			if hrp then
				local d = (hrp.Position - from).Magnitude
				if d < bestDist then
					best, bestDist, bestPos = player, d, hrp.Position
				end
			end
		end
	end
	return best, bestDist, bestPos
end

local function hasLineOfSight(from: Vector3, to: Vector3)
	if not wallsFolder then
		return true
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { wallsFolder }
	return workspace:Raycast(from, to - from, params) == nil
end

local function runMonsterBrain(m: Monster)
	task.spawn(function()
		while monster == m and roundActive do
			local pos = m.root.Position
			local target, dist, goal = nearestTarget(pos)
			if target and goal then
				local sees = dist < Config.MONSTER_SIGHT and hasLineOfSight(pos, goal)
				m.speed = sees and Config.MONSTER_CHASE_SPEED or Config.MONSTER_HUNT_SPEED

				local path = PathfindingService:CreatePath({
					AgentRadius = 3,
					AgentHeight = 10,
					AgentCanJump = false,
					WaypointSpacing = 6,
				})
				local ok = pcall(function()
					path:ComputeAsync(Vector3.new(pos.X, 2, pos.Z), goal)
				end)
				if monster ~= m then
					break
				end
				if ok and path.Status == Enum.PathStatus.Success then
					local list = {}
					for i, wp in ipairs(path:GetWaypoints()) do
						if i > 1 then
							table.insert(list, wp.Position)
						end
					end
					m.waypoints, m.index = list, 1
				elseif sees then
					-- No path but a clear view: lunge straight at them
					m.waypoints, m.index = { goal }, 1
				end
			end
			task.wait(0.4)
		end
	end)
end

local function catchPlayer(m: Monster, player: Player, hum: Humanoid)
	m.catching[player] = true
	hum.WalkSpeed = 0
	jumpscareEvent:FireClient(player)
	task.delay(0.7, function()
		if hum.Parent then
			hum.Health = 0
		end
		m.catching[player] = nil
	end)
end

RunService.Heartbeat:Connect(function(dt)
	local m = monster
	if not m or not roundActive then
		return
	end
	local now = os.clock()
	if now < m.wakeAt or now < m.stunnedUntil then
		return
	end

	local pos = m.root.Position
	local wp = m.waypoints[m.index]
	if wp then
		local target = Vector3.new(wp.X, MONSTER_ROOT_Y, wp.Z)
		local delta = target - pos
		local dist = delta.Magnitude
		local step = m.speed * dt
		local newPos
		if dist <= step then
			newPos = target
			m.index += 1
		else
			newPos = pos + delta.Unit * step
		end
		if dist > 0.05 then
			m.model:PivotTo(CFrame.lookAt(newPos, newPos + Vector3.new(delta.X, 0, delta.Z)))
		end
		pos = newPos
	end

	for player, s in pairs(status) do
		if s == "Alive" and not m.catching[player] then
			local hrp, hum = getAliveParts(player)
			if hrp and hum then
				local flat = Vector3.new(hrp.Position.X - pos.X, 0, hrp.Position.Z - pos.Z)
				if flat.Magnitude < Config.MONSTER_KILL_RANGE then
					catchPlayer(m, player, hum)
				end
			end
		end
	end
end)

---------------------------------------------------------------------------
-- Keys and exit
---------------------------------------------------------------------------

local function playerFromHit(hit)
	local model = hit:FindFirstAncestorOfClass("Model")
	return model and Players:GetPlayerFromCharacter(model)
end

onKeyTouched = function(key, hit)
	if not roundActive or not key.Parent then
		return
	end
	local player = playerFromHit(hit)
	if not player or status[player] ~= "Alive" then
		return
	end
	key:Destroy()
	keysFound += 1
	setShared("KeysFound", keysFound)
	notifyAll(
		player.DisplayName .. " found a key (" .. keysFound .. "/" .. Config.KEYS_TO_ESCAPE .. ")",
		Color3.fromRGB(255, 210, 60)
	)
	if keysFound >= Config.KEYS_TO_ESCAPE and exitDoor then
		exitOpen = true
		exitDoor.Color = Color3.fromRGB(0, 255, 120)
		exitDoor.Transparency = 0.4
		exitDoor.CanCollide = false
		local light = exitDoor:FindFirstChild("GateLight")
		if light then
			light.Color = Color3.fromRGB(0, 255, 120)
		end
		notifyAll("THE GATE IS OPEN. RUN to the far corner!", Color3.fromRGB(0, 255, 120))
		-- Opening the gate breaks any active freeze: the endgame is always a chase
		if monster then
			monster.stunnedUntil = 0
		end
	end
end

onExitTouched = function(hit)
	if not roundActive or not exitOpen then
		return
	end
	local player = playerFromHit(hit)
	if not player or status[player] ~= "Alive" then
		return
	end
	setStatus(player, "Escaped")
	addEscape(player)
	notifyAll(player.DisplayName .. " ESCAPED!", Color3.fromRGB(0, 255, 120))
	player:LoadCharacter()
end

---------------------------------------------------------------------------
-- Developer products (repeatable purchases)
---------------------------------------------------------------------------

local function applyStun(byPlayer)
	if roundActive and monster then
		monster.stunnedUntil = os.clock() + Config.STUN_DURATION
		notifyAll(
			byPlayer.DisplayName .. " froze the monster for " .. Config.STUN_DURATION .. "s!",
			Color3.fromRGB(120, 200, 255)
		)
	else
		pendingStuns += 1
		notify(byPlayer, "Freeze saved. It will trigger at the start of the next round.", Color3.fromRGB(120, 200, 255))
	end
end

local function applyRevive(player)
	if roundActive and status[player] == "Dead" then
		setStatus(player, "Alive")
		notifyAll(player.DisplayName .. " came back from the dead!", Color3.fromRGB(120, 255, 120))
		player:LoadCharacter()
	else
		reviveTokens[player] = (reviveTokens[player] or 0) + 1
		notify(player, "Revive saved. You'll come back automatically next time you're caught.", Color3.fromRGB(120, 255, 120))
	end
end

local handledPurchases = {}

MarketplaceService.ProcessReceipt = function(receipt)
	if handledPurchases[receipt.PurchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		-- Roblox will retry next time they join
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if receipt.ProductId == Config.Products.Revive then
		applyRevive(player)
	elseif receipt.ProductId == Config.Products.StunMonster then
		applyStun(player)
	else
		warn("Unknown product purchased: " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	handledPurchases[receipt.PurchaseId] = true
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

---------------------------------------------------------------------------
-- Round loop
---------------------------------------------------------------------------

local function startRound()
	wallsFolder = buildMaze()
	task.wait(1) -- let the navigation mesh catch up with the new walls

	roundActive = true
	setShared("State", "Round")
	for _, player in ipairs(Players:GetPlayers()) do
		setStatus(player, "Alive")
		task.spawn(function()
			player:LoadCharacter()
		end)
	end

	local m = buildMonster(cellCenter(W, 1))
	monster = m
	runMonsterBrain(m)
	if pendingStuns > 0 then
		pendingStuns -= 1
		m.wakeAt += Config.STUN_DURATION
	end

	notifyAll(
		"Find " .. Config.KEYS_TO_ESCAPE .. " keys. It wakes in " .. Config.MONSTER_WAKE_DELAY .. " seconds...",
		Color3.fromRGB(255, 80, 80)
	)
end

local function endRound(timedOut)
	roundActive = false
	if monster then
		monster.model:Destroy()
		monster = nil
	end

	local escaped = {}
	for player, s in pairs(status) do
		if s == "Escaped" then
			table.insert(escaped, player.DisplayName)
		end
	end
	if #escaped > 0 then
		notifyAll("Survivors: " .. table.concat(escaped, ", "), Color3.fromRGB(0, 255, 120))
	elseif timedOut then
		notifyAll("Time's up. The Hollow keeps you.", Color3.fromRGB(255, 60, 60))
	else
		notifyAll("Nobody escaped.", Color3.fromRGB(255, 60, 60))
	end

	setShared("State", "Ended")
	task.wait(3)
	for _, player in ipairs(Players:GetPlayers()) do
		local wasInMaze = status[player] == "Alive"
		setStatus(player, "Lobby")
		if wasInMaze then
			task.spawn(function()
				player:LoadCharacter()
			end)
		end
	end
end

while true do
	setShared("State", "Waiting")
	while #Players:GetPlayers() < Config.MIN_PLAYERS do
		task.wait(1)
	end

	setShared("State", "Intermission")
	for t = Config.INTERMISSION, 1, -1 do
		setShared("TimeLeft", t)
		task.wait(1)
	end

	if #Players:GetPlayers() >= Config.MIN_PLAYERS then
		startRound()
		local t = Config.ROUND_TIME
		while t > 0 and aliveCount() > 0 do
			setShared("TimeLeft", t)
			task.wait(1)
			t -= 1
		end
		endRound(t <= 0)
		task.wait(2)
	end
end
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX00000007"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000006"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000005"><Properties><string name="Name">ClientMain</string><ProtectedString name="Source"><![CDATA[-- ClientMain (LocalScript in StarterPlayer > StarterPlayerScripts)
-- HUD, flashlight, sprint/stamina, shop, jumpscares and the "it's close" effects.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")
local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("Config"))
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local camera = workspace.CurrentCamera

local function make(className, props, parent)
	local obj = Instance.new(className)
	for k, v in pairs(props) do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

local function sound(id, props)
	if id == "" then
		return nil
	end
	local s = make("Sound", { SoundId = id }, SoundService)
	for k, v in pairs(props or {}) do
		s[k] = v
	end
	return s
end

---------------------------------------------------------------------------
-- Sound design
---------------------------------------------------------------------------

-- Everything echoes like it's bouncing down concrete halls
SoundService.AmbientReverb = Enum.ReverbType.StoneCorridor

local sounds = {} -- slot name -> Sound, only for slots that loaded

local function loadSlot(slot, props)
	for _, id in ipairs(Config.Sounds[slot] or {}) do
		local s = sound(id, props)
		local loaded = false
		pcall(function()
			ContentProvider:PreloadAsync({ s }, function(_, status)
				loaded = status == Enum.AssetFetchStatus.Success
			end)
		end)
		if loaded then
			s.Name = slot
			sounds[slot] = s
			return s
		end
		s:Destroy()
	end
	warn("[The Hollow] No working sound for '" .. slot .. "'. Put a new ID first in Config.Sounds." .. slot)
	return nil
end

local function play(slot, props)
	local s = sounds[slot]
	if not s then
		return
	end
	for k, v in pairs(props or {}) do
		s[k] = v
	end
	s:Play()
end

-- Plays a copy of a sound from a point in the world, so it comes from a direction
local function playAt(slot, position, props)
	local template = sounds[slot]
	if not template then
		return
	end
	local emitter = make("Part", {
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Size = Vector3.new(0.2, 0.2, 0.2),
		Position = position,
	}, workspace)
	local s = template:Clone()
	s.RollOffMinDistance = 10
	s.RollOffMaxDistance = 120
	for k, v in pairs(props or {}) do
		s[k] = v
	end
	s.Parent = emitter
	s:Play()
	Debris:AddItem(emitter, 12)
end

local function inMaze()
	return ReplicatedStorage:GetAttribute("State") == "Round" and player:GetAttribute("Status") == "Alive"
end

-- Growl that comes from the monster itself, so you can hear which way it is
local function attachGrowl(monster)
	local head = monster:WaitForChild("Head", 5)
	if not head or not sounds.Growl then
		return
	end
	local growl = sounds.Growl:Clone()
	growl.RollOffMinDistance = 8
	growl.RollOffMaxDistance = 90
	growl.Parent = head
	task.spawn(function()
		while monster.Parent do
			task.wait(math.random(40, 90) / 10)
			if monster.Parent then
				growl.PlaybackSpeed = math.random(75, 95) / 100
				growl:Play()
			end
		end
	end)
end

task.spawn(function()
	loadSlot("Jumpscare", { Volume = 1 })
	loadSlot("Key", { Volume = 0.6 })
	loadSlot("Stinger", { Volume = 0.6 })
	loadSlot("Whisper", { Volume = 0.7 })
	loadSlot("Growl", { Volume = 1 })
	local ambient = loadSlot("Ambient", { Looped = true, Volume = 0.35 })
	if ambient then
		ambient:Play()
	end
	local heartbeat = loadSlot("Heartbeat", { Looped = true, Volume = 0 })
	if heartbeat then
		heartbeat:Play()
	end

	local existing = workspace:FindFirstChild("Monster")
	if existing then
		attachGrowl(existing)
	end
end)

workspace.ChildAdded:Connect(function(child)
	if child.Name == "Monster" then
		attachGrowl(child)
		-- It's awake
		task.delay(Config.MONSTER_WAKE_DELAY, function()
			if child.Parent and inMaze() then
				play("Stinger", { Volume = 0.7, PlaybackSpeed = 0.7 })
			end
		end)
	end
end)

-- Key pickups chime; the last key sets off a scream somewhere in the dark
local lastKeys = 0
ReplicatedStorage:GetAttributeChangedSignal("KeysFound"):Connect(function()
	local keys = ReplicatedStorage:GetAttribute("KeysFound") or 0
	if keys > lastKeys then
		play("Key")
		if keys >= (ReplicatedStorage:GetAttribute("KeysNeeded") or math.huge) then
			play("Stinger", { Volume = 0.9, PlaybackSpeed = 0.85 })
		end
	end
	lastKeys = keys
end)

-- Random distant screams while you're in the maze
task.spawn(function()
	while true do
		task.wait(math.random(20, 50))
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp and inMaze() then
			local angle = math.random() * math.pi * 2
			local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * math.random(35, 60)
			playAt("Stinger", hrp.Position + offset, { Volume = 0.45, PlaybackSpeed = math.random(70, 100) / 100 })
		end
	end
end)

local lastWhisper = 0

---------------------------------------------------------------------------
-- HUD
---------------------------------------------------------------------------

local gui = make("ScreenGui", {
	Name = "HorrorHUD",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, player:WaitForChild("PlayerGui"))

-- Red danger overlay that fades in as the monster gets close
local danger = make("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.fromRGB(120, 0, 0),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	ZIndex = 1,
}, gui)

local statusLabel = make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 44),
	Size = UDim2.fromOffset(420, 40),
	BackgroundTransparency = 1,
	Font = Enum.Font.Creepster,
	TextSize = 34,
	TextColor3 = Color3.fromRGB(230, 230, 230),
	TextStrokeTransparency = 0.4,
	Text = "",
	ZIndex = 5,
}, gui)

local notifyLabel = make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 90),
	Size = UDim2.fromOffset(600, 32),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	TextSize = 22,
	TextColor3 = Color3.new(1, 1, 1),
	TextStrokeTransparency = 0.3,
	TextTransparency = 1,
	TextStrokeColor3 = Color3.new(0, 0, 0),
	TextWrapped = true,
	ZIndex = 5,
}, gui)

local staminaBack = make("Frame", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -24),
	Size = UDim2.fromOffset(220, 8),
	BackgroundColor3 = Color3.fromRGB(30, 30, 30),
	BorderSizePixel = 0,
	ZIndex = 5,
}, gui)
make("UICorner", { CornerRadius = UDim.new(1, 0) }, staminaBack)
local staminaFill = make("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.fromRGB(200, 200, 200),
	BorderSizePixel = 0,
	ZIndex = 6,
}, staminaBack)
make("UICorner", { CornerRadius = UDim.new(1, 0) }, staminaFill)

make("TextLabel", {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -38),
	Size = UDim2.fromOffset(400, 20),
	BackgroundTransparency = 1,
	Font = Enum.Font.Gotham,
	TextSize = 14,
	TextColor3 = Color3.fromRGB(150, 150, 150),
	Text = UserInputService.TouchEnabled and "" or "SHIFT run   F flashlight",
	ZIndex = 5,
}, gui)

local notifyToken = 0
remotes:WaitForChild("Notify").OnClientEvent:Connect(function(text, color)
	notifyToken += 1
	local myToken = notifyToken
	notifyLabel.Text = text
	notifyLabel.TextColor3 = color or Color3.new(1, 1, 1)
	notifyLabel.TextTransparency = 0
	notifyLabel.TextStrokeTransparency = 0.3
	task.delay(3.5, function()
		if notifyToken == myToken then
			TweenService:Create(notifyLabel, TweenInfo.new(1), {
				TextTransparency = 1,
				TextStrokeTransparency = 1,
			}):Play()
		end
	end)
end)

local function formatTime(t)
	return string.format("%d:%02d", math.floor(t / 60), t % 60)
end

local function refreshStatus()
	local state = ReplicatedStorage:GetAttribute("State")
	local t = ReplicatedStorage:GetAttribute("TimeLeft") or 0
	local myStatus = player:GetAttribute("Status")
	if state == "Waiting" then
		statusLabel.Text = "Waiting for players..."
	elseif state == "Intermission" then
		statusLabel.Text = "Next round in " .. t
	elseif state == "Round" then
		local keys = (ReplicatedStorage:GetAttribute("KeysFound") or 0) .. "/" .. (ReplicatedStorage:GetAttribute("KeysNeeded") or 0)
		if myStatus == "Dead" then
			statusLabel.Text = "You were taken   " .. formatTime(t)
		elseif myStatus == "Escaped" then
			statusLabel.Text = "You escaped   " .. formatTime(t)
		elseif myStatus == "Alive" then
			statusLabel.Text = "Keys " .. keys .. "   " .. formatTime(t)
		else
			statusLabel.Text = "Round in progress   " .. formatTime(t)
		end
	else
		statusLabel.Text = ""
	end
end

---------------------------------------------------------------------------
-- Shop
---------------------------------------------------------------------------

local shop = make("Frame", {
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -16, 1, -16),
	Size = UDim2.fromOffset(180, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BackgroundTransparency = 1,
	ZIndex = 5,
}, gui)
make("UIListLayout", {
	Padding = UDim.new(0, 6),
	VerticalAlignment = Enum.VerticalAlignment.Bottom,
	SortOrder = Enum.SortOrder.LayoutOrder,
}, shop)

local function shopButton(text, color, order, onClick)
	local b = make("TextButton", {
		Size = UDim2.fromOffset(180, 38),
		BackgroundColor3 = color,
		BackgroundTransparency = 0.15,
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextColor3 = Color3.new(1, 1, 1),
		Text = text,
		LayoutOrder = order,
		AutoButtonColor = true,
		ZIndex = 6,
	}, shop)
	make("UICorner", { CornerRadius = UDim.new(0, 8) }, b)
	b.Activated:Connect(onClick)
	return b
end

local passButtons = {}
for name, id in pairs(Config.GamePasses) do
	if id > 0 then
		passButtons[name] = shopButton(Config.ShopText[name] or name, Color3.fromRGB(90, 60, 160), 1, function()
			MarketplaceService:PromptGamePassPurchase(player, id)
		end)
	end
end

local reviveButton, stunButton
if Config.Products.Revive > 0 then
	reviveButton = shopButton(Config.ShopText.Revive, Color3.fromRGB(30, 140, 70), 3, function()
		MarketplaceService:PromptProductPurchase(player, Config.Products.Revive)
	end)
end
if Config.Products.StunMonster > 0 then
	stunButton = shopButton(Config.ShopText.StunMonster, Color3.fromRGB(40, 110, 180), 2, function()
		MarketplaceService:PromptProductPurchase(player, Config.Products.StunMonster)
	end)
end

local function refreshShop()
	for name, button in pairs(passButtons) do
		button.Visible = not player:GetAttribute(name)
	end
	local inRound = ReplicatedStorage:GetAttribute("State") == "Round"
	if reviveButton then
		-- Biggest impulse buy in the game: show it the moment you die
		local dead = inRound and player:GetAttribute("Status") == "Dead"
		reviveButton.Visible = dead
		reviveButton.Size = dead and UDim2.fromOffset(180, 54) or UDim2.fromOffset(180, 38)
		reviveButton.Text = dead and "REVIVE NOW" or Config.ShopText.Revive
	end
	if stunButton then
		stunButton.Visible = inRound
	end
end

---------------------------------------------------------------------------
-- Flashlight (local only, follows the camera)
---------------------------------------------------------------------------

local lightPart = make("Part", {
	Name = "FlashlightLocal",
	Anchored = true,
	CanCollide = false,
	CanQuery = false,
	CanTouch = false,
	Transparency = 1,
	Size = Vector3.new(0.2, 0.2, 0.2),
}, workspace)
local spot = make("SpotLight", {
	Face = Enum.NormalId.Front,
	Shadows = true,
	Color = Color3.fromRGB(255, 244, 220),
}, lightPart)

local flashlightOn = true
local function applyFlashlight()
	local super = player:GetAttribute("SuperFlashlight")
	spot.Enabled = flashlightOn
	spot.Range = super and 60 or 32
	spot.Angle = super and 70 or 45
	spot.Brightness = super and 3 or 1.6
end
applyFlashlight()

local clickSound = sound("rbxasset://sounds/switch.wav", { Volume = 0.4 })

local function toggleFlashlight()
	flashlightOn = not flashlightOn
	if clickSound then
		clickSound:Play()
	end
	applyFlashlight()
end

---------------------------------------------------------------------------
-- Sprint and stamina
---------------------------------------------------------------------------

local stamina = 1
local wantsSprint = false

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.LeftShift then
		wantsSprint = true
	elseif input.KeyCode == Enum.KeyCode.F then
		toggleFlashlight()
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift then
		wantsSprint = false
	end
end)

-- Mobile buttons
if UserInputService.TouchEnabled then
	local run = make("TextButton", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -210, 1, -110),
		Size = UDim2.fromOffset(70, 70),
		BackgroundColor3 = Color3.fromRGB(40, 40, 40),
		BackgroundTransparency = 0.3,
		Text = "RUN",
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = 6,
	}, gui)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, run)
	run.MouseButton1Down:Connect(function()
		wantsSprint = true
	end)
	run.MouseButton1Up:Connect(function()
		wantsSprint = false
	end)
	local light = make("TextButton", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -290, 1, -110),
		Size = UDim2.fromOffset(60, 60),
		BackgroundColor3 = Color3.fromRGB(40, 40, 40),
		BackgroundTransparency = 0.3,
		Text = "LIGHT",
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = 6,
	}, gui)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, light)
	light.Activated:Connect(toggleFlashlight)
end

---------------------------------------------------------------------------
-- Jumpscare
---------------------------------------------------------------------------

local scaring = false

local function jumpscare()
	if scaring then
		return
	end
	scaring = true
	play("Jumpscare")

	local layer = make("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		ZIndex = 50,
	}, gui)

	-- A crude, pale, stretched face built from UI shapes (swap for an image asset later)
	local face = make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.45, 0.85),
		BackgroundColor3 = Color3.fromRGB(205, 200, 190),
		BorderSizePixel = 0,
		ZIndex = 51,
	}, layer)
	make("UICorner", { CornerRadius = UDim.new(0.45, 0) }, face)
	local scale = make("UIScale", { Scale = 0.2 }, face)

	local function feature(pos, size, color, z, round)
		local f = make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = pos,
			Size = size,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			ZIndex = z,
		}, face)
		if round then
			make("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
		end
		return f
	end
	local black = Color3.new(0, 0, 0)
	local red = Color3.fromRGB(255, 0, 0)
	feature(UDim2.fromScale(0.3, 0.35), UDim2.fromScale(0.26, 0.17), black, 52, true)
	feature(UDim2.fromScale(0.7, 0.33), UDim2.fromScale(0.26, 0.19), black, 52, true)
	feature(UDim2.fromScale(0.3, 0.36), UDim2.fromScale(0.06, 0.04), red, 53, true)
	feature(UDim2.fromScale(0.7, 0.34), UDim2.fromScale(0.06, 0.04), red, 53, true)
	local mouth = feature(UDim2.fromScale(0.5, 0.72), UDim2.fromScale(0.5, 0.3), black, 52, true)
	for i = 1, 7 do
		make("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(i / 8, 0),
			Size = UDim2.fromScale(0.07, 0.3 + (i % 2) * 0.15),
			Rotation = (i % 2 == 0) and 8 or -8,
			BackgroundColor3 = Color3.fromRGB(230, 225, 200),
			BorderSizePixel = 0,
			ZIndex = 53,
		}, mouth)
	end

	TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.5 }):Play()

	local start = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local k = math.max(0, 1 - (os.clock() - start) / 1.1)
		face.Position = UDim2.new(0.5, math.random(-25, 25) * k, 0.5, math.random(-25, 25) * k)
		layer.BackgroundColor3 = (math.random() < 0.3) and Color3.fromRGB(90, 0, 0) or black
	end)

	task.delay(1.2, function()
		conn:Disconnect()
		TweenService:Create(layer, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(face, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
		for _, d in ipairs(face:GetDescendants()) do
			if d:IsA("Frame") then
				TweenService:Create(d, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			end
		end
		task.wait(0.6)
		layer:Destroy()
		scaring = false
	end)
end

remotes:WaitForChild("Jumpscare").OnClientEvent:Connect(jumpscare)

---------------------------------------------------------------------------
-- Per-frame: flashlight follow, sprint, monster proximity
---------------------------------------------------------------------------

RunService:BindToRenderStep("HorrorEffects", Enum.RenderPriority.Camera.Value + 1, function(dt)
	lightPart.CFrame = camera.CFrame

	-- Sprint
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local infinite = player:GetAttribute("InfiniteStamina")
	if hum and hum.Health > 0 and hum.WalkSpeed > 0 then
		local moving = hum.MoveDirection.Magnitude > 0.1
		local sprinting = wantsSprint and moving and (infinite or stamina > 0)
		hum.WalkSpeed = sprinting and Config.SPRINT_SPEED or Config.WALK_SPEED
		if sprinting and not infinite then
			stamina = math.max(0, stamina - dt / Config.STAMINA_SECONDS)
		elseif not sprinting then
			stamina = math.min(1, stamina + dt * Config.STAMINA_REGEN)
		end
	end
	staminaFill.Size = UDim2.fromScale(infinite and 1 or stamina, 1)
	staminaFill.BackgroundColor3 = infinite and Color3.fromRGB(170, 120, 255)
		or (stamina < 0.25 and Color3.fromRGB(220, 60, 60) or Color3.fromRGB(200, 200, 200))

	-- Monster proximity: red tint + camera shake
	local monster = workspace:FindFirstChild("Monster")
	local root = monster and monster.PrimaryPart
	local intensity = 0
	if root then
		local d = (root.Position - camera.CFrame.Position).Magnitude
		intensity = math.clamp(1 - d / 45, 0, 1)
	end
	danger.BackgroundTransparency = 1 - 0.35 * intensity

	-- Heartbeat gets louder and faster as it closes in; whispers when it's very close
	local heartbeat = sounds.Heartbeat
	if heartbeat then
		heartbeat.Volume = intensity * 0.9
		heartbeat.PlaybackSpeed = 0.9 + intensity * 0.6
	end
	if intensity > 0.55 and os.clock() - lastWhisper > 12 then
		lastWhisper = os.clock()
		play("Whisper")
	end
	if intensity > 0 then
		local s = 0.006 * intensity
		camera.CFrame *= CFrame.Angles((math.random() - 0.5) * s, (math.random() - 0.5) * s, 0)
	end
end)

---------------------------------------------------------------------------
-- Keep HUD in sync
---------------------------------------------------------------------------

for _, attr in ipairs({ "State", "TimeLeft", "KeysFound", "KeysNeeded" }) do
	ReplicatedStorage:GetAttributeChangedSignal(attr):Connect(function()
		refreshStatus()
		refreshShop()
	end)
end
player.AttributeChanged:Connect(function()
	refreshStatus()
	refreshShop()
	applyFlashlight()
end)
refreshStatus()
refreshShop()
